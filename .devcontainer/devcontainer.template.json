// .devcontainer/devcontainer.json
{
  "name": "climate-map",
  "dockerComposeFile": [
    "../docker-compose.dev.yml"
  ],
  "service": "app",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "docker.docker",
        "esbenp.prettier-vscode",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "openai.chatgpt"
      ]
    }
  },
  "features": {
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // "initializeCommand": [
  //   "bash",
  //   "-c",
  //   "SOCK=/var/run/docker.sock; GID=$(stat -c '%g' $SOCK); if ! getent group $GID >/dev/null 2>&1; then groupadd -g $GID host-docker; fi; usermod -aG $GID node"
  // ],
  "runServices": [
    "app"
  ],
  "mounts": [
    "type=bind,source=${localEnv:SSH_AGENT_DIR},target=/ssh-sockets",
    // CODEX_HOST_DIR must be a real host path to the Codex config directory.
    // Do not point it at a symlinked alias; earlier file mounts failed on the shared filesystem.
    "type=bind,source=${localEnv:CODEX_HOST_DIR}/auth.json,target=/app/.codex/auth.json",
    "type=bind,source=${localEnv:CODEX_HOST_DIR}/.credentials.json,target=/app/.codex/.credentials.json",
    "type=bind,source=${localEnv:CODEX_HOST_DIR}/rules/default.rules,target=/app/.codex/rules/default.rules"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-sockets/agent.sock",
    "CODEX_HOME": "/app/.codex",
    "FIGMA_MCP_URL": "http://host.docker.internal:3845/mcp"
  },
  "remoteUser": "node"
}
