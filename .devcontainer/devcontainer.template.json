// .devcontainer/devcontainer.json
{
  "name": "climate-map",
  "dockerComposeFile": [
    "../docker-compose.dev.yml"
  ],
  "service": "app",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "docker.docker",
        "esbenp.prettier-vscode",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "openai.chatgpt"
      ]
    }
  },
  "initializeCommand": [
    "bash",
    "${localWorkspaceFolder}/.devcontainer/sync-codex-host-files.sh",
    "${localWorkspaceFolder}"
  ],
  "features": {
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // "initializeCommand": [
  //   "bash",
  //   "-c",
  //   "SOCK=/var/run/docker.sock; GID=$(stat -c '%g' $SOCK); if ! getent group $GID >/dev/null 2>&1; then groupadd -g $GID host-docker; fi; usermod -aG $GID node"
  // ],
  "runServices": [
    "app"
  ],
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh/sockets,target=/ssh-sockets",
    "type=bind,source=${localWorkspaceFolder}/.codex/auth.json,target=/app/.codex/auth.json",
    "type=bind,source=${localWorkspaceFolder}/.codex/.credentials.json,target=/app/.codex/.credentials.json",
    "type=bind,source=${localWorkspaceFolder}/.codex/rules/default.rules,target=/app/.codex/rules/default.rules"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-sockets/agent.sock",
    "CODEX_HOME": "/app/.codex",
    "FIGMA_MCP_URL": "http://host.docker.internal:3845/mcp"
  },
  "remoteUser": "node"
}
