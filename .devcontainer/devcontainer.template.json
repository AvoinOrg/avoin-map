{
  "name": "avoin-map",
  "dockerComposeFile": [
    "../docker-compose.dev.yml"
  ],
  "service": "app",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "docker.docker",
        "esbenp.prettier-vscode",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "openai.chatgpt"
      ]
    }
  },
  "initializeCommand": [
    "bash",
    "-lc",
    "'${localWorkspaceFolder}/.devcontainer/sync-codex-host-files.sh' '${localWorkspaceFolder}' && '${localWorkspaceFolder}/.devcontainer/ensure-docker-network.sh' climate-map-network"
  ],
  "features": {},
  "runServices": [
    "app"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-sockets/agent.sock",
    "CODEX_HOME": "/app/.codex",
    "CODEX_SQLITE_HOME": "/home/node/dev/.codex/sqlite"
  },
  "remoteUser": "node"
}
