# Create a .env file and copy and set these values there to override the defaults.
# Do not add secret keys to this file

# set to prod if you want to use the production version of the app
COMPOSE_PROFILES=dev

# Used by docker. Sets the localhost port where the app is available.
DEV_PORT=3000

# Optional host folder for the container shared-browser persistent profile
# (cache/cookies/localStorage/IndexedDB/extensions). Default is project-local:
# ./.dev/live-browser-persist
# WSL path examples: ./.dev/live-browser-persist or /mnt/c/Users/<you>/AvoinMap/live-browser-data
# LIVE_BROWSER_CONTAINER_DATA_HOST_DIR=./.dev/live-browser-persist

# The client side next.js variables, visible to any user.
# ----------------------------------

# The applets which are compiled. If not listed here, the folders are deleted during build.
# If only one applet is listed here (and it's not "main"), then the app runs as a standalone applet.
NEXT_PUBLIC_COMPILED_APPLETS=main

# Used to link back to the main app from applets
NEXT_PUBLIC_APPLETS_MAIN_DOMAIN=https://map.example.org

# If you want to link to other applets running under other domains, then set them as such:
# NEXT_PUBLIC_APPLETS_{appletName}_DOMAIN=

# Debug helper: set to 1 in production builds to keep client stack traces readable
# (enables browser sourcemaps and disables minification in next.config.js).
# NEXT_PUBLIC_DEBUG_CLIENT_ERRORS=1

# Umami analytics configuration.
# Both the script URL and the applet's website ID must be set for analytics to be enabled.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.org/umami.js
# NEXT_PUBLIC_APPLETS_HIILIKARTTA_UMAMI_ID=
# NEXT_PUBLIC_APPLETS_ENERGIAKARTTA_UMAMI_ID=
# NEXT_PUBLIC_APPLETS_LUONNONMETSAKARTAT_UMAMI_ID=
# NEXT_PUBLIC_APPLETS_FORESTS_UMAMI_ID=

# The URL of the Avoin geoserver, serving map data.
NEXT_PUBLIC_GEOSERVER_URL=https://gis.example.org/geoserver
# Needed for the mapbox map. See https://docs.mapbox.com/help/getting-started/access-tokens/
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Needed for translations.
NEXT_PUBLIC_TOLGEE_API_URL=https://tolgee.example.org
NEXT_PUBLIC_TOLGEE_API_KEY=

# Not necessary. Needed only for the satellite layer of the map.
NEXT_PUBLIC_TERRAMONITOR_KEY=
# Not necessary. The url of the avoin map backend.
NEXT_PUBLIC_API_URL=

# Required for authentication. The app should run fine without these.
# ----------------------------------
NEXT_PUBLIC_ZITADEL_ISSUER=https://auth.example.org
ZITADEL_CLIENT_ID=123123@zitadel-project
ZITADEL_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=any-secret

MML_API_KEY=
