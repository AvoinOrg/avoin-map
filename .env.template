# Create a .env file and copy and set these values there to override the defaults.
# Do not add secret keys to this file

# Used by docker. Sets the localhost port where the app is available.
DEV_PORT=3000
COMPOSE_FILE=docker-compose.dev.yml

# Optional host folder for the container shared-browser persistent profile
# (cache/cookies/localStorage/IndexedDB/extensions). Default is project-local:
# ./.dev/live-browser-persist
# WSL path examples: ./.dev/live-browser-persist or /mnt/c/Users/<you>/AvoinMap/live-browser-data
# LIVE_BROWSER_CONTAINER_DATA_HOST_DIR=./.dev/live-browser-persist

# Used by devcontainer SSH agent socket bind via ${localEnv:SSH_AGENT_DIR}.
# This is documented here for local setup, but devcontainer reads it from the
# host environment rather than from docker-compose.
# SSH_AGENT_DIR=/home/<you>/.ssh/sockets

# The repo-local .codex directory is the source of truth for this project in
# both local shells and the devcontainer. The devcontainer initialize helper
# only ensures these files exist before mounting them:
# .codex/auth.json
# .codex/.credentials.json
# .codex/rules/default.rules

# Public client-side variables, visible to any user.
# ----------------------------------

# The applets which are compiled. If not listed here, the folders are deleted during build.
# If only one applet is listed here (and it's not "main"), then the app runs as a standalone applet.
NEXT_PUBLIC_COMPILED_APPLETS=main

# Optional public site origin used for absolute app URLs during hosted builds.
# Netlify sets this from DEPLOY_PRIME_URL in netlify.toml.
# NEXT_PUBLIC_URL=https://map.example.org

# Used to link back to the main app from applets
NEXT_PUBLIC_APPLETS_MAIN_DOMAIN=https://map.example.org

# If an applet runs under its own domain, use the singular runtime/redirect name:
# NEXT_PUBLIC_APPLET_{appletName}_DOMAIN=

# Debug helper: set to 1 in production builds to keep client stack traces readable
# (enables sourcemaps and disables minification in Start builds).
# NEXT_PUBLIC_DEBUG_CLIENT_ERRORS=1

# Optional Start deployment target. Leave unset for the local node-server
# output; Netlify uses START_TARGET=netlify through yarn build:netlify.
# START_TARGET=netlify

# Optional override for generated Netlify applet-domain proxy targets. Netlify
# builds normally use DEPLOY_PRIME_URL or URL instead.
# NETLIFY_REDIRECTS_BASE_URL=https://deploy-preview.example.netlify.app

# Umami analytics configuration.
# Both the script URL and the applet's website ID must be set for analytics to be enabled.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.org/umami.js
# NEXT_PUBLIC_APPLETS_HIILIKARTTA_UMAMI_ID=
# NEXT_PUBLIC_APPLETS_ENERGIAKARTTA_UMAMI_ID=
# NEXT_PUBLIC_APPLETS_LUONNONMETSAKARTAT_UMAMI_ID=
# NEXT_PUBLIC_APPLETS_FORESTS_UMAMI_ID=

# The URL of the Avoin geoserver, serving map data.
NEXT_PUBLIC_GEOSERVER_URL=https://gis.example.org/geoserver
# Energiakartta building polygon tiles are currently published under the
# sandbox_energiakartta workspace on the Energiakartta GeoServer.
NEXT_PUBLIC_ENERGIAKARTTA_GEOSERVER_URL=https://sandbox.gis.avoin.org/geoserver
# Needed for the mapbox map. See https://docs.mapbox.com/help/getting-started/access-tokens/
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Needed for translations.
NEXT_PUBLIC_TOLGEE_API_URL=https://tolgee.example.org
NEXT_PUBLIC_TOLGEE_API_KEY=

# Not necessary. Needed only for the satellite layer of the map.
NEXT_PUBLIC_TERRAMONITOR_KEY=
# Not necessary. The url of the avoin map backend.
NEXT_PUBLIC_API_URL=

# Required for authentication. The app should run fine without these.
# ----------------------------------
NEXT_PUBLIC_ZITADEL_ISSUER=https://auth.example.org
# Server-only Zitadel issuer for Better Auth. Falls back to NEXT_PUBLIC_ZITADEL_ISSUER
# during the migration, but production deployments should set this explicitly.
ZITADEL_ISSUER=https://auth.example.org
ZITADEL_CLIENT_ID=123123@zitadel-project
ZITADEL_CLIENT_SECRET=
# Better Auth canonical server URL and secret. Local development can omit these
# and use http://localhost:3000 plus a dev-only secret; production must set both
# explicitly. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional Zitadel redirect URI override. The local Avoin Zitadel client is
# currently registered for the legacy callback path on localhost:3000; Start
# rewrites that path to Better Auth's Generic OAuth callback internally.
# ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback/zitadel
# Optional comma-separated origins accepted for Better Auth callbacks/redirects
# in addition to BETTER_AUTH_URL.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MML_API_KEY=

# Server-only base URL for the Hiilikartta API proxy.
HIILIKARTTA_API_URL=https://hiilikartta-api.example.org

# Server-only base URL for the Luonnonmetsakartat API proxy.
LUONNONMETSAKARTAT_API_URL=https://luonnonmetsakartat-api.example.org
